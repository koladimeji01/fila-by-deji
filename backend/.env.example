# Copy to .env. NEVER commit .env or credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./fila_local.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
