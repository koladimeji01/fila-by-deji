# REFERENCE TEMPLATE ONLY. Set these in your hosting provider's SECRET settings.
# DO NOT rename this to .env and commit real credentials.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
RATE_LIMIT_REDIS_URL=rediss://REDIS_USER:URL_ENCODED_PASSWORD@REDIS_HOST:6380/0
JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_GENERATED_PRIVATELY
CORS_ORIGINS=https://YOUR-EXACT-WEBSITE-DOMAIN.example
ACCESS_TOKEN_MINUTES=30
# Hosting providers typically inject PORT automatically.
